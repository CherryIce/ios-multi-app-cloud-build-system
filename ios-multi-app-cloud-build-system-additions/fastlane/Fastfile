# PSEUDOCODE DRAFT: adapt this to a real App repository and validate it there.
# The production implementation in this repository is the root composite action.

default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_API_KEY_P8_PATH")
    )
  end

  private_lane :build_ipa do
    match(type: ENV.fetch("MATCH_TYPE", "appstore"), readonly: true)
    build_app(
      scheme: ENV.fetch("SCHEME"),
      export_method: ENV.fetch("EXPORT_METHOD", "app-store"),
      output_directory: ENV.fetch("BITRISE_DEPLOY_DIR", "artifacts"),
      clean: true
    )
    lane_context[SharedValues::IPA_OUTPUT_PATH]
  end

  desc "Build one configured App and retain its IPA"
  lane :build do
    build_ipa
  end

  desc "Upload only; this does not prove TestFlight readiness"
  lane :upload_only do
    ipa_path = build_ipa
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa_path,
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload and wait for normal TestFlight processing"
  lane :beta do
    ipa_path = build_ipa
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa_path,
      distribute_external: false,
      skip_waiting_for_build_processing: false
    )
  end

  desc "Manually update the match repository; do not run this in release CI"
  lane :sync_signing do
    match(
      type: ENV.fetch("MATCH_TYPE", "appstore"),
      git_url: ENV.fetch("MATCH_GIT_URL"),
      readonly: false
    )
  end
end
